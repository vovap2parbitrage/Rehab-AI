APP_NAME=Rehab AI API
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-this-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=postgresql+psycopg://rehab:rehab@localhost:5432/rehab_ai
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Keycloak configuration
KEYCLOAK_ENABLED=true
# Internal URL the backend uses to reach Keycloak.
KEYCLOAK_SERVER_URL=http://localhost:8080
# Public issuer URL embedded in tokens. Leave empty when KEYCLOAK_SERVER_URL is public.
KEYCLOAK_ISSUER_URL=
KEYCLOAK_REALM=rehab-ai
KEYCLOAK_CLIENT_ID=rehab-ai-backend
KEYCLOAK_AUDIENCE=rehab-ai-backend
KEYCLOAK_VERIFY_AUDIENCE=true
KEYCLOAK_JWKS_CACHE_TTL_SECONDS=300

# Confidential Keycloak client with a service account (realm-management roles:
# view-realm, view-users, manage-users). Keep the secret on the server only.
KEYCLOAK_ADMIN_CLIENT_ID=rehab-ai-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-keycloak-admin-client-secret
KEYCLOAK_ADMIN_TIMEOUT_SECONDS=10
