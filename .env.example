# Copy to .env and adjust if needed:  copy .env.example .env
# Every value below has a working default, so .env is optional for local runs.
# The defaults avoid the ports commonly used by an older local AIRehab stack.

# --- Ports exposed on the host ---------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8001
KEYCLOAK_PORT=8081
KEYCLOAK_MANAGEMENT_PORT=9001
POSTGRES_PORT=5433
REDIS_PORT=6380

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=rehab_ai
POSTGRES_USER=rehab
POSTGRES_PASSWORD=rehab

# --- Backend ----------------------------------------------------------------
# Must be at least 32 characters.
SECRET_KEY=dev-secret-key-change-me-0123456789abcdef
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# --- Keycloak ---------------------------------------------------------------
# Public URL opened by the browser. Also used as the JWT issuer.
# If you change FRONTEND_PORT, also update the redirect URIs in
# keycloak/realm-export.json and rebuild the frontend.
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Service-account secret from keycloak/realm-export.json. Keep both in sync if
# you change it.
KEYCLOAK_ADMIN_CLIENT_SECRET=rehab-ai-admin-dev-secret

# --- Frontend build-time values --------------------------------------------
# The React app is compiled with these values, so rebuild after changing them.
VITE_API_BASE_URL=http://localhost:8001
