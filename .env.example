# Copy to .env and adjust if needed:  copy .env.example .env
# Every value below has a working default, so .env is optional for local runs.
# The defaults avoid the ports commonly used by an older local AIRehab stack.

# --- Ports exposed on the host ---------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8001
POSTGRES_PORT=5433
REDIS_PORT=6380

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=rehab_ai
POSTGRES_USER=rehab
POSTGRES_PASSWORD=rehab

# --- Backend ----------------------------------------------------------------
# Must be at least 32 characters.
SECRET_KEY=dev-secret-key-change-me-0123456789abcdef
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# HTTP on localhost needs false. Set true behind HTTPS.
COOKIE_SECURE=false

# --- Frontend build-time values --------------------------------------------
# The React app is compiled with this value, so rebuild after changing it.
VITE_API_BASE_URL=http://localhost:8001
